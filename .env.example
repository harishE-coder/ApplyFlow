# ==============================================================================
# ApplyFlow ATS — Environment Configuration Template
# Copy this file to backend/.env and configure with your environment settings.
# ==============================================================================

# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-host.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require
USE_SQLITE=false

# Security & Tokens
JWT_SECRET_KEY=your-production-jwt-secret-key-here
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_WEBAPP_ID/exec
GROQ_API_KEY=your-groq-api-key-here
FRONTEND_URL=http://localhost:5173

# Web Push (VAPID)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:admin@applyflow.com

# Super Admin Account Initial Seed
ADMIN_NAME=Harish
ADMIN_EMAIL=harishabblu123@gmail.com
ADMIN_PASSWORD=your-super-admin-secure-password
# ==============================================================================
# ApplyFlow ATS — Environment Configuration Template
# Copy this file to .env and configure with your environment settings.
# ==============================================================================

# Database Configuration (PostgreSQL by default; set USE_SQLITE=True for local development)
USE_SQLITE=True
DATABASE_URL_OVERRIDE=sqlite+aiosqlite:///./applyflow.db

# If using PostgreSQL:
# USE_SQLITE=False
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=applyflow
# DB_USER=applyflow_user
# DB_PASSWORD=your_secure_db_password

# Authentication & JWT Security (Generate a secure random string for production)
JWT_SECRET_KEY=change-me-to-a-secure-random-32-char-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Interview Intake Engine (Groq LLaMA 3.3 70B)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Cloud Storage (Google Apps Script Web App for Google Drive integration)
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_WEBAPP_ID/exec
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_google_drive_root_folder_id

# Client Frontend URL & CORS
FRONTEND_URL=http://localhost:5173

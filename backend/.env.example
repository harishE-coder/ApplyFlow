# ==============================================================================
# ApplyFlow ATS — Backend Environment Configuration Template
# Copy this file to .env and configure with your environment settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Local Development (Docker PostgreSQL or SQLite)
# ------------------------------------------------------------------------------
USE_SQLITE=false

DB_HOST=localhost
DB_PORT=5432
DB_NAME=applyflow
DB_USER=applyflow_user
DB_PASSWORD=strong_password

# ------------------------------------------------------------------------------
# 2. Production Database (Neon / Render / Supabase PostgreSQL)
# If DATABASE_URL is set, it automatically overrides local DB settings.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/applyflow?ssl=require

# ------------------------------------------------------------------------------
# 3. Production Multi-Worker Cache (Redis)
# Enables cluster-wide tag invalidation across all Gunicorn/Uvicorn workers.
# Leave empty to use fast in-memory TTL caching automatically.
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# Example Render/Upstash Redis URL:
# REDIS_URL=rediss://default:secretpassword@example-redis-provider.com:6379

# ------------------------------------------------------------------------------
# 4. Security & JWT Authentication
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=change-me-to-a-secure-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 5. Super Admin Initial Seed Credentials
# ------------------------------------------------------------------------------
ADMIN_NAME=Harish Admin
ADMIN_EMAIL=admin@applyflow.com
ADMIN_PASSWORD=ApplyFlow@2026!

# ------------------------------------------------------------------------------
# 6. Centralized Silent AI Gateway (Multi-Key & Multi-Provider Fallback)
# Priority Order: GROQ 1 -> GROQ 2 -> GROQ 3 -> OpenAI -> Gemini
# Features: 60s circuit breaker, dynamic health scoring, and intra-provider model fallback.
# ------------------------------------------------------------------------------
# Groq Multiple Keys (Primary provider)
GROQ_API_KEY_1=gsk_example_primary_key_0123456789abcdef
GROQ_API_KEY_2=gsk_example_secondary_backup_key_abcdef
GROQ_API_KEY_3=gsk_example_tertiary_backup_key_fedcba
GROQ_API_KEY=gsk_example_legacy_key_if_using_single_key

# OpenAI Fallback Provider
OPENAI_API_KEY=sk-proj-example_openai_api_key_abc123xyz

# Google Gemini Fallback Provider
GEMINI_API_KEY=AIzaSyExample_Gemini_Api_Key_0123456789

# Configurable Preferred Models
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 7. Google Apps Script & Drive Integration (Resume Cloud Sync)
# ------------------------------------------------------------------------------
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbx_example_id/exec
GOOGLE_DRIVE_ROOT_FOLDER_ID=1A2B3C4D5E6F7G8H9I0J_EXAMPLE_FOLDER_ID

# ------------------------------------------------------------------------------
# 8. Supabase Storage (Interview Intelligence Dataset & Models)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://example-project.supabase.co
SUPABASE_SECRET_KEY=eyJhbGciOi...example_supabase_service_role_key
SUPABASE_BUCKET=applyflow-storage

# ------------------------------------------------------------------------------
# 9. CORS & Frontend URL
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
